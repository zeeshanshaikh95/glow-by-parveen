# ─────────────────────────────────────────────────────────────
# Glow by Parveen — environment configuration (SERVER)
# Copy this file to server/.env and fill in real values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Port for the Express API server
PORT=4000

# MongoDB connection string.
# Local dev:  mongodb://127.0.0.1:27017/glow-by-parveen
# Production: MongoDB Atlas connection string (free tier is fine).
MONGODB_URI=mongodb://127.0.0.1:27017/glow-by-parveen

# Secret used to sign admin JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Admin JWT lifetime, e.g. "12h"
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed frontend origins (CORS).
# Dev: http://localhost:5173
# Prod: https://<username>.github.io,https://<custom-domain>
CORS_ORIGINS=http://localhost:5173

# Public URL of the frontend (used for canonical URLs / OG metadata defaults)
PUBLIC_SITE_URL=http://localhost:5173

# Public URL of this API (used in docs / admin UI hints)
PUBLIC_API_URL=http://localhost:4000

# ── Cloudinary image storage ─────────────────────────────────────
# Server-side only. The API key and secret must NEVER be exposed to the
# frontend, committed to git, pasted into client-side env vars (anything
# prefixed VITE_*), or written into API responses / logs.
# Find them at: Cloudinary Console → Settings → API Keys
#   Product environment cloud name:  <cloud-name>
#   API key:                         <api-key>
#   API secret:                      <api-secret>
# Locally they live in server/.env (git-ignored); on Render add the same three
# variables in the dashboard (Environment → Add Environment Variable).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: Cloudinary folder for new uploads (default: glow-by-parveen)
CLOUDINARY_FOLDER=glow-by-parveen

# Optional: upload limits enforced by the API before anything is stored.
# Defaults: 8 MB per image, 10 images per request.
UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_FILES=10

# NOTE: without CLOUDINARY_* the API still starts and uploads fall back to
# local disk storage (server/uploads). Configure Cloudinary to store images off
# the ephemeral filesystem.

# Initial admin account — used ONLY by the seed script when creating the first admin.
# Stored as a bcrypt hash; never hardcoded in the frontend or logged by the API.
# A freshly bootstrapped admin MUST change this password on first login before
# the admin panel becomes usable. If the bootstrap password is still in use,
# re-running the seed re-arms that requirement.
ADMIN_EMAIL=admin@glowbyparveen.com
ADMIN_PASSWORD=[CHANGE_ME_BEFORE_PRODUCTION]
